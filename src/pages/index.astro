          <div><strong>{s.title}</strong><span>Conceptual &middot; letter, {s.orient}</span></div>
          <a class="btn btn--small btn--outline" href={`${dl}sadler-farms-${s.slug}.pdf`} download>PDF &middot; {s.pdf_size}</a>
