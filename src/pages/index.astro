---
import Default from '../layouts/Default.astro';
import Compare from '../components/Compare.astro';
import Lightbox from '../components/Lightbox.astro';
import cotton from '../components/cotton.svg?raw';
import locationIllustration from '../components/location-illustration.svg?raw';
import d from '../data/developer.json';
import { m } from '../media';

const dl = '/assets/downloads/';
const video = {
  name: 'Sadler Farms — a waterfront development opportunity on Wheeler Lake',
  description: 'A 45-second drone film of Sadler Farms, almost 300 acres with more than a mile of shoreline on Wheeler Lake (Tennessee River) in Limestone County, Alabama, for prospective development partners.',
  thumbnail: '/assets/media/video/pitch/poster.jpg',
  content: '/assets/media/video/pitch/master.m3u8',
  uploadDate: '2026-10-23',
  duration: 'PT45S',
};
---
<Default
  title="Sadler Farms — Lakeside Living on Wheeler Lake"
  description="Sadler Farms: almost 300 acres with more than a mile of waterfront on Wheeler Lake and the Tennessee River in Limestone County, Alabama — a vision for lakeside living, with site facts, conceptual plans and surveys for developers and builders."
  preloadImage="/assets/media/video/pitch/poster.jpg"
  video={video}
>
<header class="hero hero--video" id="top">
  <div class="hero__media">
    <video class="js-hls hero__video" data-src="/assets/media/video/pitch/master.m3u8"
           poster="/assets/media/video/pitch/poster.jpg" autoplay muted loop playsinline preload="auto"></video>
  </div>

  <nav class="nav">
    <a class="nav__brand" href="#top"><span class="nav__mark"><Fragment set:html={cotton} /></span> Sadler Farms</a>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
    <div class="nav__links" id="nav-links">
      <a href="#vision">Vision</a>
      <a href="#residences">Residences</a>
      <a href="#waterfront">Waterfront</a>
      <a href="#land">The Land</a>
      <a href="#location">Location</a>
      <a href="#gallery">Gallery</a>
      <a href="#developers">Developers</a>
    </div>
  </nav>

  <div class="hero__content">
    <p class="eyebrow">Wheeler Lake &middot; Tennessee River &middot; Alabama</p>
    <h1 class="hero__title">A new vision for lakeside living.</h1>
    <p class="hero__lede">
      Almost 300 acres of gently contoured fields and mature forests, with substantial direct
      waterfront along one of the widest stretches of Wheeler Lake on the Tennessee River.
    </p>
    <div class="hero__actions">
      <button class="btn js-watch" type="button">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
        Watch the film
      </button>
      <a class="btn btn--ghost" href="#vision">Explore the vision</a>
    </div>
  </div>

  <button class="hero__close js-close-film" type="button" aria-label="Close film">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M19 6.4 17.6 5 12 10.6 6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12z"/></svg>
    <span>Close</span>
  </button>
  <div class="hero__progress" aria-hidden="true"><span></span></div>

  <div class="player-bar" data-for=".hero__video">
    <button class="player-bar__sound js-sound" type="button" aria-pressed="false">
      <svg class="icon-off" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3zm13.6 3 2.7-2.7-1.4-1.4-2.7 2.7-2.7-2.7-1.4 1.4 2.7 2.7-2.7 2.7 1.4 1.4 2.7-2.7 2.7 2.7 1.4-1.4z"/></svg>
      <svg class="icon-on" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 8v8a4.5 4.5 0 0 0 2.5-4zM14 3.2v2.1a7 7 0 0 1 0 13.4v2.1a9 9 0 0 0 0-17.6z"/></svg>
      <span class="label-off">Turn sound on</span><span class="label-on">Sound on</span>
    </button>
    <label class="player-bar__quality">
      <span class="visually-hidden">Video quality</span>
      <select class="js-quality" aria-label="Video quality"><option value="-1">Auto</option></select>
    </label>
    <button class="player-bar__icon js-fullscreen" type="button" aria-label="Full screen">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
    </button>
  </div>
</header>

<section class="stats">
  <div class="stats__item"><span class="stats__head">Waterfront Community</span><span class="stats__label">Development Opportunity</span></div>
  <div class="stats__item"><span class="stats__head">Community Marina</span><span class="stats__label">Wet Slips and Dry Boat Storage</span></div>
  <div class="stats__item"><span class="stats__head">300 Acres</span><span class="stats__label">Pristine Landscape</span></div>
  <div class="stats__item"><span class="stats__head">Prime Location</span><span class="stats__label stats__label--tight"><span class="nowrap">Athens &ndash; 15 Minutes</span><br><span class="nowrap">Huntsville &ndash; 25 Minutes</span></span></div>
</section>

<main>
  <!-- ============================================================ Intro -->
  <section class="section" id="vision">
    <div class="wrap split">
      <div class="split__text reveal">
        <p class="eyebrow">The vision</p>
        <h2 class="section__title">One extraordinary landscape.</h2>
        <p>
          Sadler Farms is a rare opportunity to create a distinctive waterfront community
          on Wheeler Lake, in Limestone County, in close proximity to Alabama&rsquo;s dynamic and
          fast-growing city of Huntsville. A place where open farmland, legacy forests, and
          expansive lake views come together.
        </p>
        <p>
          The vision is a thoughtfully planned community, from two-bedroom townhomes overlooking a common marina to private one-acre estate
          homesites along the water — designed around the land.
        </p>
        <p class="note">Concept only — subject to planning, engineering, and approvals.</p>
      </div>
      <figure class="split__media reveal">
        <img src={m('photos/41-1600.webp')} width="1600" height="1198" srcset={`${m('photos/41-800.webp')} 800w, ${m('photos/41-1600.webp')} 1600w`}
             sizes="(max-width: 860px) 100vw, 55vw" alt="Open pasture and tree islands with Wheeler Lake beyond" loading="lazy">
      </figure>
    </div>
  </section>

  <!-- ============================================================ Before / after -->
  <section class="section section--tight">
    <div class="wrap">
      <div class="section__head reveal">
        <p class="eyebrow">Today &amp; tomorrow</p>
        <h2 class="section__title">Picture the vision.</h2>
        <p class="section__intro">Drag the slider to compare the land as it is today with an artist&rsquo;s concept of what it could become. Double-tap or use the corner button for a full-screen view you can zoom.</p>
      </div>
      <div class="reveal">
        <Compare start="40" before={m('photos/41-1600.webp')} beforeLarge={m('photos/41-1600.webp')} beforeW="1600" beforeH="1198" beforeAlt="Sadler Farms today: pasture, forest and Wheeler Lake"
          after={m('concepts/overview-1440.webp')} afterLarge={m('concepts/overview-1440.webp')} afterW="1449" afterH="1085" afterAlt="Artist's concept: homes, a marina and trails set into the same landscape" />
      </div>
    </div>
  </section>

  <!-- ============================================================ Residences -->
  <section class="section section--sand" id="residences">
    <div class="wrap">
      <div class="section__head reveal">
        <p class="eyebrow">A diversity of residences</p>
        <h2 class="section__title">Homes shaped by the setting.</h2>
        <p class="section__intro">Many ways to live on the land — each placed where the landscape suits it best. Tap any image to see it full size and zoom in.</p>
      </div>
      <div class="grid grid--2">
        <article class="tile reveal">
          <a class="tile__media" href={m('concepts/marina-1440.webp')} data-lightbox>
            <img src={m('concepts/marina-800.webp')} srcset={`${m('concepts/marina-800.webp')} 800w, ${m('concepts/marina-1440.webp')} 1774w`} sizes="(max-width: 760px) 100vw, 50vw"
                 width="800" height="400" alt="Artist's concept: Cove Inn Marina Townhomes, the inn at the head of the cove above a boat ramp and docks, with townhomes along both banks and covered boat storage" loading="lazy">
            <span class="plan__zoom">View larger</span>
          </a>
          <div class="tile__body">
            <h3>Cove Inn Marina and Townhomes</h3>
            <p>Waterfront Townhomes situated in a protected cove overlooking a community marina and views of Wheeler Lake!</p>
          </div>
        </article>
        <article class="tile reveal">
          <a class="tile__media" href={m('concepts/estates-1440.webp')} data-lightbox>
            <img src={m('concepts/estates-800.webp')} srcset={`${m('concepts/estates-800.webp')} 800w, ${m('concepts/estates-1440.webp')} 1774w`} sizes="(max-width: 760px) 100vw, 50vw"
                 width="800" height="400" alt="Artist's concept: Waterfront Estates, four lakefront homes above a shared pool and a covered boathouse with boat slips" loading="lazy">
            <span class="plan__zoom">View larger</span>
          </a>
          <div class="tile__body">
            <h3>Waterfront Estates</h3>
            <p>Waterfront Estate Homes and Boat Houses &mdash; An extraordinary vision of luxury lakefront living, featuring breathtaking panoramic views across the widest expanse of Wheeler Lake!</p>
          </div>
        </article>
        <article class="tile reveal">
          <a class="tile__media" href={m('concepts/riverview-1440.webp')} data-lightbox>
            <img src={m('concepts/riverview-800.webp')} srcset={`${m('concepts/riverview-800.webp')} 800w, ${m('concepts/riverview-1440.webp')} 1774w`} sizes="(max-width: 760px) 100vw, 50vw"
                 width="800" height="400" alt="Artist's concept: Riverview Residences, three condominium buildings with pools, gazebos and gardens along the lakeshore" loading="lazy">
            <span class="plan__zoom">View larger</span>
          </a>
          <div class="tile__body">
            <h3>Riverview Residences</h3>
            <p>Where spectacular lake views, beautiful architecture, and unforgettable moments come together!</p>
          </div>
        </article>
        <article class="tile reveal">
          <a class="tile__media" href={m('concepts/ranch-1440.webp')} data-lightbox>
            <img src={m('concepts/ranch-800.webp')} srcset={`${m('concepts/ranch-800.webp')} 800w, ${m('concepts/ranch-1440.webp')} 1774w`} sizes="(max-width: 760px) 100vw, 50vw"
                 width="800" height="400" alt="Artist's concept: Ranch Estates, single-family estate homes on open lawns along a winding road, set among mature hardwood forest above Wheeler Lake" loading="lazy">
            <span class="plan__zoom">View larger</span>
          </a>
          <div class="tile__body">
            <h3>Ranch Estates</h3>
            <p>Estate homes ranging in size from 2,500&nbsp;SF to 4,500&nbsp;SF with 3&ndash;5 bedrooms, blending into the natural preserved landscape of mature hardwood forests and rolling green fields!</p>
          </div>
        </article>
      </div>
      <p class="note note--center">Artist&rsquo;s concepts for illustration only. Residential types, locations and quantities would be set through the development planning process.</p>
    </div>
  </section>

  <!-- ============================================================ Waterfront -->
  <section class="feature" id="waterfront">
    <video class="js-hls feature__video" data-src="/assets/media/video/waterfront/master.m3u8"
           poster="/assets/media/video/waterfront/poster.jpg" muted loop playsinline preload="none"></video>
    <div class="feature__content wrap">
      <div class="feature__card reveal">
        <p class="eyebrow">An extraordinary waterfront setting</p>
        <h2>More than a mile along the Tennessee River. Endless possibilities.</h2>
        <p>
          The property runs for more than a mile along the Tennessee River&rsquo;s Wheeler Lake,
          just east of where the Elk River joins &mdash; partly direct waterfront and partly bordering
          narrow strips of TVA waterfront land. These spectacular park-like forested areas are
          undeveloped land for wildlife habitat, recreation, walking trails, and fishing ledges,
          forever protected from development.
        </p>
        <p>
          This dramatic shoreline faces south across one of the widest and completely undeveloped
          stretches of Wheeler Lake. Several protected coves, one large and possibly suitable for
          a marina, cut into the shoreline.
        </p>
        <ul class="ticks">
          <li>Boating and cruising Wheeler Lake, Tennessee River</li>
          <li>Kayaking and paddleboarding along the shoreline</li>
          <li>Fishing &mdash; one of the premier river-reservoir fisheries in the Southeast, and a top destination for bass</li>
          <li>Swimming and watersports</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============================================================ Marina -->
  <section class="section">
    <div class="wrap split split--reverse">
      <div class="split__text reveal">
        <p class="eyebrow">A common marina</p>
        <h2 class="section__title">The heart of the community.</h2>
        <p>
          Envision a potential marina nestled in a naturally protected cove — a gathering place
          for residents and an everyday gateway to the lake.
        </p>
        <ul class="ticks ticks--dark">
          <li>Common boat ramp</li>
          <li>Shared docks for residents and guests</li>
          <li>Individual dry boat storage</li>
          <li>Landscaped gathering areas overlooking the water</li>
        </ul>
        <p class="note">Marina features, capacity, and locations are subject to engineering, permitting, and regulatory approval.</p>
      </div>
      <div class="split__media split__media--video reveal">
        <video class="js-hls" data-src="/assets/media/video/cove/master.m3u8" poster="/assets/media/video/cove/poster.jpg"
               muted loop playsinline preload="none" aria-label="Drone footage of a sheltered cove"></video>
      </div>
    </div>
  </section>

  <!-- ============================================================ Land & legacy -->
  <section class="feature feature--right" id="land">
    <video class="js-hls feature__video" data-src="/assets/media/video/meadow/master.m3u8"
           poster="/assets/media/video/meadow/poster.jpg" muted loop playsinline preload="none"></video>
    <div class="feature__content wrap">
      <div class="feature__card reveal">
        <p class="eyebrow">A landscape preserved for generations</p>
        <h2>More than a development. A legacy of land.</h2>
        <p>
          For almost 80 years, one family has farmed and cared for this property — its mature
          hardwoods, fertile fields, and hidden meadows. This vision carries that forward:
        </p>
        <ul class="ticks">
          <li>Walking trails through mature forests and open fields</li>
          <li>Common green space and scenic lake overlooks</li>
          <li>Roads that follow the natural contours of the land</li>
          <li>Homesites placed to preserve views and trees</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============================================================ Location -->
  <section class="section" id="location">
    <div class="wrap">
      <div class="section__head reveal">
        <p class="eyebrow">Location</p>
        <h2 class="section__title">The quiet of the lake. The opportunity of the city.</h2>
        <p class="section__intro">Davis Road &amp; Snake Road, Limestone County, Alabama.</p>
      </div>
      <div class="location">
        <div class="location__map reveal">
          <iframe title="Map showing Sadler Farms near Athens and Huntsville, Alabama"
                  src="https://maps.google.com/maps?q=34.7768,-87.1772&amp;z=10&amp;output=embed"
                  loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <div class="location__facts">
          <div class="fact reveal">
            <span class="fact__num">15<small>min</small></span>
            <div><h3>Athens</h3><p>Historic downtown, shopping, dining — and a new high school.</p></div>
          </div>
          <div class="fact reveal">
            <span class="fact__num">25<small>min</small></span>
            <div><h3>Huntsville</h3><p>One of the fastest-growing cities in the U.S., a hub for aerospace, defense, and technology jobs.</p></div>
          </div>
          <div class="fact reveal">
            <span class="fact__num">2</span>
            <div><h3>County roads</h3><p>The property is bordered by two county roads.</p></div>
          </div>
        </div>
      </div>
      <figure class="location__illus reveal">
        <Fragment set:html={locationIllustration} />
      </figure>
    </div>
  </section>

  <!-- ============================================================ Gallery -->
  <section class="section section--dark" id="gallery">
    <div class="wrap">
      <div class="section__head reveal">
        <p class="eyebrow">From the air</p>
        <h2 class="section__title">Gallery</h2>
      </div>
      <div class="gallery">
        <a class="gallery__item reveal" href={m('photos/43-1600.webp')}>
          <img src={m('photos/43-800.webp')} width="800" height="599" alt="Wide fields sloping toward Wheeler Lake" loading="lazy">
        </a>
        <a class="gallery__item reveal" href={m('photos/5-1600.webp')}>
          <img src={m('photos/5-800.webp')} width="800" height="599" alt="Mature forests and meadows along the lake" loading="lazy">
        </a>
        <a class="gallery__item reveal" href={m('photos/30-1600.webp')}>
          <img src={m('photos/30-800.webp')} width="800" height="599" alt="Meadow hidden in mature forest" loading="lazy">
        </a>
        <a class="gallery__item reveal" href={m('photos/59-1600.webp')}>
          <img src={m('photos/59-800.webp')} width="800" height="599" alt="Wooded shoreline on a wide stretch of the lake" loading="lazy">
        </a>
        <a class="gallery__item reveal" href={m('photos/25-1600.webp')}>
          <img src={m('photos/25-800.webp')} width="800" height="599" alt="Boat cruising past the wooded shoreline" loading="lazy">
        </a>
        <a class="gallery__item reveal" href={m('photos/44-1600.webp')}>
          <img src={m('photos/44-800.webp')} width="800" height="599" alt="Farm pond among open fields" loading="lazy">
        </a>
        <a class="gallery__item reveal" href={m('photos/7-1600.webp')}>
          <img src={m('photos/7-800.webp')} width="800" height="599" alt="Fields and forest with the lake beyond" loading="lazy">
        </a>
        <a class="gallery__item reveal" href={m('photos/28-1600.webp')}>
          <img src={m('photos/28-800.webp')} width="800" height="599" alt="Quiet inlet between wooded banks" loading="lazy">
        </a>
        <a class="gallery__item reveal" href={m('photos/48-1600.webp')}>
          <img src={m('photos/48-800.webp')} width="800" height="599" alt="Open field above the lake" loading="lazy">
        </a>
        <a class="gallery__item reveal" href={m('photos/61-1600.webp')}>
          <img src={m('photos/61-800.webp')} width="800" height="599" alt="Wooded point on Wheeler Lake" loading="lazy">
        </a>
        <a class="gallery__item reveal" href={m('photos/53-1600.webp')}>
          <img src={m('photos/53-800.webp')} width="800" height="599" alt="Forest and meadow with lake views" loading="lazy">
        </a>
        <a class="gallery__item reveal" href={m('photos/13-1600.webp')}>
          <img src={m('photos/13-800.webp')} width="800" height="599" alt="Mature hardwoods along the shoreline" loading="lazy">
        </a>
        <a class="gallery__item reveal" href={m('photos/27-1600.webp')}>
          <img src={m('photos/27-800.webp')} width="800" height="599" alt="Protected cove off the main lake" loading="lazy">
        </a>
        <a class="gallery__item reveal" href={m('photos/12-1600.webp')}>
          <img src={m('photos/12-800.webp')} width="800" height="599" alt="Peninsula of mature forest on the water" loading="lazy">
        </a>
        <a class="gallery__item reveal" href={m('photos/56-1600.webp')}>
          <img src={m('photos/56-800.webp')} width="800" height="599" alt="Pasture and tree lines above the lake" loading="lazy">
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================ Developers -->
  <section class="page-header" id="developers">
    <div class="page-header__content wrap">
      <p class="eyebrow">For developers &amp; builders</p>
      <h2 class="page-header__title">A lakeside development opportunity on Wheeler Lake.</h2>
      <p class="page-header__lede">
        Almost 300 acres with more than a mile along the Tennessee River&rsquo;s Wheeler Lake,
        several coves, and frontage on two county roads. Below are the site facts, conceptual plans and
        surveys for planning and due diligence &mdash; each available as a PDF.
      </p>
      <div class="hero__actions">
        <a class="btn" href="/assets/downloads/sadler-farms-developer-package.pdf" download>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M5 20h14v-2H5v2zM12 16l5.5-5.5-1.4-1.4L13 12.2V3h-2v9.2L7.9 9.1 6.5 10.5 12 16z"/></svg>
          Developer package (PDF, {d.package_size})
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================================ Facts -->
  <section class="section" id="facts">
    <div class="wrap wrap--mid">
      <div class="section__head reveal">
        <p class="eyebrow">Site facts</p>
        <h2 class="section__title">The property at a glance.</h2>
      </div>
      <dl class="facts reveal">
        {d.facts.map((f) => (
        <div class="facts__row"><dt>{f.label}</dt><dd>{f.value}</dd></div>
        ))}
      </dl>
      <p class="note note--center">Approximate; to be verified during due diligence.</p>
    </div>
  </section>

  <!-- ============================================================ Plans -->
  <section class="section section--sand" id="plans">
    <div class="wrap">
      <div class="section__head reveal">
        <p class="eyebrow">Conceptual plans</p>
        <h2 class="section__title">One way the land could come together.</h2>
        <p class="section__intro">Illustrative concepts to frame discussion &mdash; not engineered, surveyed or approved.</p>
      </div>
      {d.sheets.filter((s) => s.kind !== 'survey').map((s) => (
      <article class="plan reveal">
        <a class="plan__media" href={m(`plans/${s.web}-full.webp`)} data-lightbox>
          <img src={m(`plans/${s.web}-800.webp`)} width="800" height="731" alt={s.title} loading="lazy">
          <span class="plan__zoom">View larger</span>
        </a>
        <div class="plan__body">
          <p class="eyebrow">Sheet {s.no}</p>
          <h3>{s.title}</h3>
          <p>{s.note}</p>
          <div class="plan__actions">
            <a class="btn btn--small" href={`${dl}sadler-farms-${s.slug}.pdf`} download>Download PDF &middot; {s.pdf_size}</a>
            <a class="link" href={m(`plans/${s.web}-full.webp`)} target="_blank" rel="noopener">Open full size</a>
          </div>
        </div>
      </article>
      ))}
    </div>
  </section>

  <!-- ============================================================ Surveys -->
  <section class="section" id="surveys">
    <div class="wrap">
      <div class="section__head reveal">
        <p class="eyebrow">Surveys</p>
        <h2 class="section__title">Boundary and topographic survey.</h2>
        <p class="section__intro">Prepared for Sadler Farms LLC by Barge Waggoner Sumner &amp; Cannon (BWSC). The signed, full-size surveys (42&nbsp;&times;&nbsp;30&nbsp;in) are available below as PDFs.</p>
      </div>
      {d.sheets.filter((s) => s.kind === 'survey').map((s) => (
      <article class="plan plan--portrait reveal">
        <a class="plan__media" href={m(`plans/${s.web}-full.webp`)} data-lightbox>
          <img src={m(`plans/${s.web}-800.webp`)} width="800" height="1116" alt={`${s.title}, ${s.date}`} loading="lazy">
          <span class="plan__zoom">View larger</span>
        </a>
        <div class="plan__body">
          <p class="eyebrow">Survey &middot; {s.date}</p>
          <h3>{s.title}</h3>
          <p>{s.note}</p>
          <div class="plan__actions">
            <a class="btn btn--small" href={`${dl}${s.original}`} download>Download signed survey &middot; {s.pdf_size}</a>
            <a class="link" href={m(`plans/${s.web}-full.webp`)} target="_blank" rel="noopener">Open full size</a>
          </div>
        </div>
      </article>
      ))}
    </div>
  </section>

  <!-- ============================================================ Documents -->
  <section class="section section--sand" id="documents">
